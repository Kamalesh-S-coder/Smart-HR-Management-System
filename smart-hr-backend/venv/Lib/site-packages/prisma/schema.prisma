// prisma/schema.prisma

generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// RULE 1, 7 & 9: SECURITY, AUTH, & RBAC
// ==========================================
model Role {
  id                 String   @id @default(uuid())
  name               String   @unique // e.g., "Admin", "HR", "Employee"
  can_view_salaries  Boolean  @default(false)
  can_approve_leaves Boolean  @default(false)
  can_revoke_devices Boolean  @default(false)
  users              User[]
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  employee_id   String   @unique
  password_hash String?
  login_mode    String   @default("EMAIL_PASS") // EMAIL_PASS, OTP
  
  role_id       String
  role          Role     @relation(fields: [role_id], references: [id])
  
  profile       EmployeeProfile?
  devices       DeviceFingerprint[]
  attendance    AttendanceRecord[]
  leaves        LeaveRequest[]
  payroll       PayrollRecord[]
  shifts        Shift[]
  audit_logs    AuditLog[]
}

// RULE 1: THREAT DETECTION & DEVICE MANAGEMENT
model DeviceFingerprint {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id])
  device_os     String   
  browser       String   
  ip_address    String
  last_location String?  
  is_active     Boolean  @default(true) 
  last_login    DateTime @default(now())
}

// RULE 9: THE INVISIBLE LEDGER
model AuditLog {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  action      String   // e.g., "REVOKED_DEVICE", "APPROVED_LEAVE"
  timestamp   DateTime @default(now())
}

// ==========================================
// RULE 2: EMPLOYEE PROFILE ENGINE
// ==========================================
model EmployeeProfile {
  id              String   @id @default(uuid())
  user_id         String   @unique
  user            User     @relation(fields: [user_id], references: [id])
  
  full_name       String
  phone           String?
  address         String?
  bank_account    String?
  health_score    Int      @default(100) // Drops based on anomalies
  admin_notes     String?  // Hidden from employee
  assets_assigned String?
}

// ==========================================
// RULE 3: SMART ATTENDANCE ENGINE
// ==========================================
model AttendanceRecord {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  
  date         DateTime @default(now())
  clock_in     DateTime
  clock_out    DateTime?
  work_mode    String   // OFFICE, REMOTE, HYBRID
  gps_location String?
  is_anomaly   Boolean  @default(false) // Flagged by the logic engine
}

// ==========================================
// RULE 4: PAYROLL & COMPENSATION ENGINE
// ==========================================
model PayrollRecord {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  
  month        String   // e.g., "2026-06"
  salary_model String   // TIME_BASED, ATTENDANCE_BASED, HYBRID
  base_pay     Float
  deductions   Float    @default(0)
  net_pay      Float
  is_paid      Boolean  @default(false)
}

// ==========================================
// RULE 5: LEAVE MANAGEMENT ENGINE
// ==========================================
model LeaveRequest {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  
  leave_type String   // SICK, VACATION, CASUAL
  start_date DateTime
  end_date   DateTime
  reason     String
  status     String   @default("PENDING") // APPROVED, REJECTED
}

// ==========================================
// RULE 6: SHIFT SCHEDULING ENGINE
// ==========================================
model Shift {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  
  shift_date DateTime
  start_time DateTime
  end_time   DateTime
}